{
  "name": "mvp-lunar",
  "version": "1.0.1",
  "description": "MVP Lunar audio mixer and soundboard controller",
  "homepage": "https://github.com/hartezmenot/mvplunar",
  "author": {
    "name": "hartezmenot",
    "email": "chaox.league@gmail.com"
  },
  "private": true,
  "type": "commonjs",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "app:dev": "electron .",
    "app:linux": "electron .",
    "app:windows": "electron .",
    "build:appimage": "electron-builder --linux AppImage",
    "build:deb": "electron-builder --linux deb",
    "build:linux": "electron-builder --linux AppImage deb",
    "build:win": "electron-builder --win nsis",
    "build:win:portable": "electron-builder --win portable",
    "build:windows": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mvp.lunar",
    "productName": "MVP Lunar",
    "icon": "assets/icon.png",
    "files": [
      "**/*",
      "!data/**",
      "!.github/**",
      "!app.js.bak"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false
    },
    "linux": {
      "maintainer": "hartezmenot <chaox.league@gmail.com>",
      "icon": "assets/icon.png",
      "desktop": {
        "Name": "MVP Lunar",
        "Comment": "Audio mixer and soundboard controller",
        "Categories": "AudioVideo;Audio"
      },
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo;Audio"
    }
  }
}
